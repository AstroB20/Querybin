# Copy this file to .env, then run:  docker compose up --build -d
#
# As shipped, it starts a demo PostgreSQL database with sample tables so you can try the builder.
# To use your own database, remove COMPOSE_PROFILES and change the TARGET_DB_* values.

COMPOSE_PROFILES=demo

# --- the admin login for the builder (control plane). CHANGE THE PASSWORD. ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- the database whose tables become APIs ---
# PostgreSQL, MySQL/MariaDB and H2 are supported:
#   jdbc:postgresql://host:5432/dbname
#   jdbc:mysql://host:3306/dbname
# Use host.docker.internal as the host for a database running on this machine.
# Use a read-only account: the builder never needs to write to your database.
TARGET_DB_URL=jdbc:postgresql://demo-db:5432/demo
TARGET_DB_USER=demo
TARGET_DB_PASSWORD=demo

# Schema (PostgreSQL) or database (MySQL) to expose. Empty means the connection's default.
TARGET_DB_SCHEMA=

# --- where each plane is reachable from outside the containers ---
# Builder = the DBA's design tool. Keep it on localhost.
BUILDER_PORT=8080
BUILDER_BIND=127.0.0.1
# Runtime = the published APIs engineers call. Set RUNTIME_BIND=0.0.0.0 to share on your network.
RUNTIME_PORT=8081
RUNTIME_BIND=127.0.0.1
# Base URL used in the curl commands the builder generates (the runtime, as engineers reach it).
RUNTIME_PUBLIC_URL=http://localhost:8081

# Optional shared secret between runtime and builder for the service-to-service resolve call.
# Leave empty on a trusted private network.
INTERNAL_TOKEN=